<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- %ctx prints the MDC keys that are set: [req=... user=... op=... job=... comic=... date=...] -->
    <conversionRule conversionWord="ctx" class="org.stapledon.infrastructure.logging.MdcContextConverter"/>

    <!-- Compact stack traces, defined once by logging.exception-conversion-word in application.properties -->
    <property name="EXCEPTION_PATTERN" value="${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- Override the default pattern to use Toronto time and print the MDC context. Must be set before console-appender.xml reads it. -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, America/Toronto}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %ctx%m%n${EXCEPTION_PATTERN}"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Batch log directory from Spring property, with fallback -->
    <springProperty name="BATCH_LOG_DIR" source="comics.cache.location" defaultValue="/tmp/comic-cache"/>

    <!-- SiftingAppender: routes batch job logs to per-execution files when MDC keys are present -->
    <appender name="BATCH_SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>batchLogPath</key>
            <defaultValue>NONE</defaultValue>
        </discriminator>
        <sift>
            <appender name="BATCH-${batchLogPath}" class="ch.qos.logback.core.FileAppender">
                <file>${BATCH_LOG_DIR}/batch-logs/${batchLogPath}.log</file>
                <append>true</append>
                <encoder>
                    <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS, America/Toronto} %-5level [%thread] %logger{39} : %ctx%msg%n${EXCEPTION_PATTERN}</pattern>
                </encoder>
            </appender>
        </sift>
        <filter class="org.stapledon.infrastructure.logging.MdcPresentFilter">
            <key>batchLogPath</key>
            <defaultValue>NONE</defaultValue>
        </filter>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="BATCH_SIFT"/>
    </root>

    <logger name="org.stapledon" level="INFO"/>
</configuration>
